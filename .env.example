# ── Supabase ──────────────────────────────────────────────────────────────
# Painel do Supabase › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave de serviço. Só roda no servidor. NUNCA prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Azure DevOps ──────────────────────────────────────────────────────────
AZURE_ORG=digidevs
AZURE_PROJECT=SQUAD PULSE
# Personal Access Token com escopo Work Items (Read)
AZURE_PAT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Campo do Azure que guarda a data de entrega combinada com o cliente.
# O padrão é o DueDate nativo. Se vocês usam campo próprio, troque pelo
# reference name dele (ex.: Custom.DataEntrega).
AZURE_CAMPO_ENTREGA=Microsoft.VSTS.Scheduling.DueDate

# Como o card é associado ao cliente: "tag" (tags do work item) ou
# "titulo" (o padrão [Prudential] no título, como no Pulse v1).
AZURE_FILTRO_CLIENTE=titulo

# ── Cron ──────────────────────────────────────────────────────────────────
# Qualquer string longa e aleatória. A Vercel manda em Authorization: Bearer
CRON_SECRET=troque-isto-por-algo-bem-aleatorio
